              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mealType\": \"lunch\",\n  \"foodName\": \"Dal Tadka with Roti\",\n  \"calories\": 450,\n  \"protein\": 18,\n  \"carbs\": 65,\n  \"fat\": 12\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/nutrition/log",
              "host": ["{{baseUrl}}"],
              "path": ["api", "nutrition", "log"]
