            },
            "description": "Scans raw fruit/vegetable photos for decay, shelf-life estimation, and storage tips."
          }
        },
        {
          "name": "Get Inventory",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/freshness/inventory",
              "host": ["{{baseUrl}}"],
