              "raw": "{\n  \"amount\": 250\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/nutrition/water",
              "host": ["{{baseUrl}}"],
              "path": ["api", "nutrition", "water"]
            },
            "description": "Adds water intake (in ml)."
          }
        }
      ]
    },
    {
      "name": "07. Diet Plan (/api/diet)",
      "item": [
        {
