# Frontend Environment Variables Template
# Replace with your deployed backend API URL (e.g., https://nutrivedic-api.onrender.com)
VITE_API_URL=https://your-backend-api.onrender.com

# Google OAuth Client ID for web sign-in (must match authorized Javascript Origins in Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
